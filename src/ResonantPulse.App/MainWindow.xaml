<Window x:Class="ResonantPulse.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="Root" Background="{ThemeResource SurfaceBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <!-- Same custom, theme-aware caption as Resonant Tuner: content extends into the title bar,
         system caption buttons stay (transparent over our surface) and the left side drags. -->
    <Grid x:Name="TitleBarRow">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition x:Name="CaptionInset" Width="140" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="DragTitleBar" Padding="16,0,0,0" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsHitTestVisible="False">
          <Grid Width="22" Height="22">
            <Ellipse Width="20" Height="20" Stroke="{ThemeResource PulseBrush}" StrokeThickness="2" />
            <Ellipse Width="11" Height="11" Stroke="{ThemeResource LaneBrush}" StrokeThickness="1.5" />
            <Ellipse Width="5" Height="5" Fill="{ThemeResource AccentBrush}" VerticalAlignment="Top" Margin="0,-2,0,0" />
          </Grid>
          <TextBlock Text="resonant pulse" FontFamily="Bahnschrift" FontSize="16"
                     Foreground="{ThemeResource TextBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Grid>
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Top" Background="Transparent"
                    IsBackButtonVisible="Collapsed" IsSettingsVisible="True"
                    AutomationProperties.AutomationId="Destinations">
      <Grid Padding="20,8,20,8" Background="{ThemeResource SurfaceBrush}">
        <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </Grid>
    </NavigationView>
    <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True"
             Margin="16,4" AutomationProperties.AutomationId="StatusNotice" />
    <Grid x:Name="TransportPanel" Grid.Row="3" Padding="20,12" Background="{ThemeResource RaisedBrush}">
      <Grid x:Name="TransportCommands" ColumnSpacing="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button x:Name="StartButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112" MaxWidth="168"
                AutomationProperties.AutomationId="TransportStartPause" HorizontalAlignment="Left" IsEnabled="False" />
        <Button x:Name="StopButton" Grid.Column="1" MinWidth="76" HorizontalAlignment="Left" AutomationProperties.AutomationId="TransportStop" />
        <Button x:Name="MuteButton" Grid.Column="2" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="EmergencyMute" />
        <TextBlock x:Name="TransportStatus" Grid.Column="3" TextWrapping="Wrap" VerticalAlignment="Center"
                   Margin="8,0" AutomationProperties.AutomationId="TransportStatus" Foreground="{ThemeResource MutedBrush}" />
        <Button x:Name="AudioOptionsButton" Grid.Column="4" MinWidth="88" HorizontalAlignment="Left"
                AutomationProperties.AutomationId="AudioOptions">
          <Button.Flyout>
            <Flyout x:Name="AudioOptionsFlyout">
              <Grid x:Name="AudioOptionsPanel" Width="440" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock x:Name="AudioOptionsTitle" FontSize="20" FontWeight="SemiBold" Style="{StaticResource BodyStyle}" />
                <ScrollViewer x:Name="AudioOptionsScroll" Grid.Row="1"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                  <Grid x:Name="OutputRow" ColumnSpacing="12" RowSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <!-- The caption sits outside the ComboBox: a header inside it makes the box 32 DIP, shorter than the
                         44 DIP refresh button beside it. Both have a 44 DIP minimum (so they can grow with Windows text
                         size) and stretch to the one row height, so they always match and share a centre line. -->
                    <StackPanel x:Name="OutputColumn" Spacing="4">
                      <TextBlock x:Name="OutputCaption" FontSize="14" Style="{StaticResource BodyStyle}" />
                      <Grid x:Name="OutputControls" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="OutputPicker" MinHeight="44" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  AutomationProperties.AutomationId="AudioOutputPicker" />
                        <Button x:Name="OutputButton" Grid.Column="1" MinWidth="44" MinHeight="44" Padding="0" VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="RefreshAudioOutputs">
                          <FontIcon Glyph="&#xE72C;" />
                        </Button>
                      </Grid>
                    </StackPanel>
                    <Slider x:Name="MasterGain" Grid.Column="1" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.5"
                            VerticalAlignment="Top" AutomationProperties.AutomationId="MasterGain" />
                    <TextBlock x:Name="OutputNote" Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource NoteStyle}"
                               AutomationProperties.AutomationId="OutputNote" />
                  </Grid>
                </ScrollViewer>
                <Button x:Name="AudioOptionsClose" Grid.Row="2" HorizontalAlignment="Right" Width="120"
                        Style="{StaticResource PrimaryButtonStyle}" AutomationProperties.AutomationId="AudioOptionsClose" />
              </Grid>
            </Flyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </Grid>
  </Grid>
</Window>
