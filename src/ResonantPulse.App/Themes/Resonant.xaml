<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Resonant family palette, independently owned resources, not a dependency
       on the concurrently developed tuner application. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0C1116" />
      <SolidColorBrush x:Key="RaisedBrush" Color="#141D24" />
      <SolidColorBrush x:Key="SunkenBrush" Color="#090E12" />
      <SolidColorBrush x:Key="TextBrush" Color="#F0F5F3" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A6B5B8" />
      <SolidColorBrush x:Key="MarkerBrush" Color="#71858F" />
      <SolidColorBrush x:Key="PulseBrush" Color="#58E4F4" />
      <SolidColorBrush x:Key="LaneBrush" Color="#EE83D3" />
      <SolidColorBrush x:Key="AccentBrush" Color="#F3E687" />
      <SolidColorBrush x:Key="OutlineBrush" Color="#273943" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F7F5" />
      <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SunkenBrush" Color="#E8EFEC" />
      <SolidColorBrush x:Key="TextBrush" Color="#10201A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#4A5E58" />
      <SolidColorBrush x:Key="MarkerBrush" Color="#526A62" />
      <SolidColorBrush x:Key="PulseBrush" Color="#00677A" />
      <SolidColorBrush x:Key="LaneBrush" Color="#A62785" />
      <SolidColorBrush x:Key="AccentBrush" Color="#805000" />
      <SolidColorBrush x:Key="OutlineBrush" Color="#CBD8D2" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="RaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MarkerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="PulseBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LaneBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="OutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="InstrumentCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style x:Key="HeadingStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
  <Style x:Key="BodyStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
  <Style x:Key="CaptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
  </Style>
  <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
  </Style>
  <!-- Secondary pages: a titled page of cards, each holding one idea (see docs/design/pages-design.md). -->
  <Style x:Key="PageCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20,16" />
  </Style>
  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Bahnschrift" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
  <Style x:Key="CardTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
  <Style x:Key="FieldCaptionStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
  <Style x:Key="NoteStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
  </Style>
  <Style x:Key="KeyChipStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SunkenBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="MinWidth" Value="32" />
  </Style>
  <Style x:Key="AccentGlyphStyle" TargetType="FontIcon">
    <Setter Property="Foreground" Value="{ThemeResource PulseBrush}" />
    <Setter Property="FontSize" Value="28" />
  </Style>
  <!-- Quiet, bordered surface for settings that show their current value (time signature, sound). -->
  <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
  </Style>
  <!-- Secondary entry points stay visibly quieter than the instrument and transport. -->
  <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="MinWidth" Value="44" />
  </Style>
  <!-- Page tools (Timer, Project, Help): no frame, but the same full-contrast text as the Settings item, so they read as
       enabled controls, not disabled ones. -->
  <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="12,0" />
  </Style>
  <!-- The framework accent style is 32 DIP tall; this keeps it exactly as tall as every neighbouring button (44 DIP). -->
  <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
  </Style>
  <Style x:Key="StepperButtonStyle" TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style x:Key="TapButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource PulseBrush}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="MinWidth" Value="132" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="16,0" />
  </Style>
  <!-- "Tap to start": a switch that reads as a button beside TAP. Off it is as quiet as Stop and Mute; on, it takes the accent
       colour that Start has. It is as tall as every other button (44 DIP) and a pill, like the controls it sits beside. -->
  <Style x:Key="TapStartToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="14,0" />
  </Style>
</ResourceDictionary>
