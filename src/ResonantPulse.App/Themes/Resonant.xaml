<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Resonant family palette, independently owned resources, not a dependency
       on the concurrently developed tuner application. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="SurfaceBrush" Color="#0C1116" />
      <SolidColorBrush x:Key="RaisedBrush" Color="#141D24" />
      <SolidColorBrush x:Key="SunkenBrush" Color="#090E12" />
      <SolidColorBrush x:Key="TextBrush" Color="#F0F5F3" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A6B5B8" />
      <SolidColorBrush x:Key="MarkerBrush" Color="#71858F" />
      <SolidColorBrush x:Key="PulseBrush" Color="#58E4F4" />
      <SolidColorBrush x:Key="LaneBrush" Color="#EE83D3" />
      <SolidColorBrush x:Key="AccentBrush" Color="#F3E687" />
      <SolidColorBrush x:Key="OutlineBrush" Color="#273943" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="SurfaceBrush" Color="#F3F7F5" />
      <SolidColorBrush x:Key="RaisedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SunkenBrush" Color="#E8EFEC" />
      <SolidColorBrush x:Key="TextBrush" Color="#10201A" />
      <SolidColorBrush x:Key="MutedBrush" Color="#4A5E58" />
      <SolidColorBrush x:Key="MarkerBrush" Color="#526A62" />
      <SolidColorBrush x:Key="PulseBrush" Color="#00677A" />
      <SolidColorBrush x:Key="LaneBrush" Color="#A62785" />
      <SolidColorBrush x:Key="AccentBrush" Color="#805000" />
      <SolidColorBrush x:Key="OutlineBrush" Color="#CBD8D2" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="RaisedBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="SunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />
      <SolidColorBrush x:Key="TextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="MarkerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="PulseBrush" Color="{ThemeResource SystemColorHighlightColor}" />
      <SolidColorBrush x:Key="LaneBrush" Color="{ThemeResource SystemColorHotlightColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
      <SolidColorBrush x:Key="OutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <Style x:Key="InstrumentCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource RaisedBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="20,12" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style x:Key="HeadingStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
  <Style x:Key="BodyStyle" TargetType="TextBlock">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{ThemeResource TextBrush}" />
  </Style>
</ResourceDictionary>
